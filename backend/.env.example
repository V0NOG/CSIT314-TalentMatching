# backend/.env.example
# Copy this file to .env and fill in your values.

# Server
NODE_ENV=development
PORT=5050
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Database — MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT secrets — use long random strings, keep separate access/refresh secrets
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Fallback if the above are not set (not recommended for production)
# JWT_SECRET=

# Token expiry (optional — defaults shown)
ACCESS_TOKEN_TTL=55m
REFRESH_TOKEN_TTL=7d

# Cookies
# COOKIE_SECURE must be "true" in production (HTTPS only)
COOKIE_SECURE=false
# COOKIE_DOMAIN: set to your domain in production (e.g. example.com)
# Leave unset or set to "localhost" to omit domain from cookies in development
# COOKIE_DOMAIN=
