# frontend/.env.example
# Copy this file to .env and fill in your values for local development.

# Backend API base URL. Do not include a trailing slash.
VITE_API_URL=http://localhost:5050

# GitHub Actions sets this automatically for GitHub Pages builds.
# Leave it unset locally unless you specifically want to test subpath hosting.
# VITE_BASE_PATH=/CSIT314-TalentMatching/

# Google OAuth client ID (for future Google sign-in integration)
VITE_GOOGLE_CLIENT_ID=
